[Unit]
Description=Moa Community Spring Boot API
After=network.target valkey.service
Requires=valkey.service

[Service]
User=ec2-user
WorkingDirectory=/opt/moa-server/backend
EnvironmentFile=/etc/moa-server/app.env
ExecStart=/usr/bin/java -jar /opt/moa-server/backend/moa-server-api.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target